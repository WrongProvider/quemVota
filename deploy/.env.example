# .env  — copie para .env e preencha antes de subir
# NÃO commite este arquivo com valores reais!

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_DB=seudb
POSTGRES_USER=rickmartin
POSTGRES_PASSWORD=nevergonnna_give_you_up
POSTGRES_SUPERSER=rickmartin
POSTGRES_SUPERPASSWORD=nevergonnna_give_you_up

# ── App ───────────────────────────────────────────────────────────────────
SECRET_KEY=GERE_COM_openssl_rand_hex_32
ENV=production

# ── Embeddings (pgvector) ─────────────────────────────────────────────────
# Dimensão fixa no DDL; alterar exige nova migration
EMBEDDING_DIMENSION=1536
EMBEDDING_MODEL=undecided

# ── Domínio ───────────────────────────────────────────────────────────────
DOMAIN=seudomiminio.com
